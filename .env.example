GITLAB_URL=https://gitlab.com
# Server-side PAT (scope read_api): stdio mode, and HTTP mode with SSO (OIDC_*)
GITLAB_TOKEN=glpat-xxx
# GITLAB_TIMEOUT_MS=20000

# VictoriaLogs tools (optional, enabled when VICTORIALOGS_URL is set). URL of VictoriaLogs or of its oauth2-proxy.
# With OIDC auth, each user's token is forwarded (oauth2-proxy: --skip-jwt-bearer-tokens --extra-jwt-issuers=<issuer>=<aud>).
# VICTORIALOGS_URL=https://logs.example.com
# Static bearer, used outside OIDC mode only:
# VICTORIALOGS_TOKEN=
# VICTORIALOGS_TIMEOUT_MS=20000

# VictoriaMetrics tools (optional, enabled when VICTORIAMETRICS_URL is set). Same rules as VictoriaLogs.
# VICTORIAMETRICS_URL=https://metrics.example.com
# VICTORIAMETRICS_TOKEN=
# VICTORIAMETRICS_TIMEOUT_MS=20000

# Transport: stdio (local) | http (deployed)
MCP_TRANSPORT=http
PORT=3000
MCP_PUBLIC_URL=https://gitlab-mcp.example.com

# HTTP auth: pick ONE of the two blocks below.

# A) GitLab login: users log in with GitLab, tools run with their own token (no GITLAB_TOKEN).
#    Non-confidential GitLab OAuth application, scope read_api.
# GITLAB_OAUTH_CLIENT_ID=<application id>
# GITLAB_OAUTH_SCOPES=read_api
# GITLAB_OAUTH_ISSUER=https://gitlab.example.com   # only if GITLAB_URL is an internal address

# B) SSO (OIDC) + server PAT. Public client registered in the IdP, redirect URI http://localhost:<callback-port>/callback
OIDC_ISSUER=https://sso.example.com/realms/company
OIDC_CLIENT_ID=gitlab-mcp
# OIDC_AUDIENCE=gitlab-mcp
# OIDC_SCOPES=openid profile email
# OIDC_JWKS_URI=

# DCR shim: MCP clients registering dynamically get OIDC_CLIENT_ID / GITLAB_OAUTH_CLIENT_ID (no client id to type)
# MCP_DCR_SHIM=false
# MCP_REDIRECT_URIS=http://localhost:*,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Log every auth step (rejections are always logged)
# MCP_DEBUG=true

# Local dev only: run HTTP without auth
# MCP_AUTH_DISABLED=true
