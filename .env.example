# GitLab (server-side PAT, scope read_api)
GITLAB_TOKEN=glpat-xxx
GITLAB_URL=https://gitlab.com
# GITLAB_TIMEOUT_MS=20000

# Transport: stdio (local) | http (deployed)
MCP_TRANSPORT=http
PORT=3000
MCP_PUBLIC_URL=https://gitlab-mcp.example.com

# SSO (OIDC). Public client registered in the IdP, redirect URI http://localhost:<callback-port>/callback
OIDC_ISSUER=https://sso.example.com/realms/company
OIDC_CLIENT_ID=gitlab-mcp
# OIDC_AUDIENCE=gitlab-mcp
# OIDC_SCOPES=openid profile email
# OIDC_JWKS_URI=

# Log every auth step (rejections are always logged)
# MCP_DEBUG=true

# Local dev only: run HTTP without auth
# MCP_AUTH_DISABLED=true
